# Database
DATABASE_URL=sqlite+aiosqlite:///./omni-route-design.db

# AI Configuration (BYOK - Bring Your Own Key)
# Configure via API: POST /api/v1/ai-config/config
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=your-api-key-here
# AI_MODEL=gpt-4o

# For local Ollama:
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.2

# For Anthropic (via OpenAI-compatible endpoint):
# AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_API_KEY=your-anthropic-key
# AI_MODEL=claude-3-opus-20240229